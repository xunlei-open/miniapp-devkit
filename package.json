{
  "name": "@xunlei-open/miniapp-devkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --stream build",
    "check": "pnpm --recursive --stream --if-present check",
    "clean": "pnpm --recursive --stream --if-present clean",
    "changeset": "changeset",
    "test": "pnpm --recursive --stream --if-present test",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}

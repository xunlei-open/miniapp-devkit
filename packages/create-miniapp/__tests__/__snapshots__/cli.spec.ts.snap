exports[`matches help snapshot 1`] = `
"Usage: @xunlei-open/create-miniapp [options] [project-name]

Xunlei Open Platform plugin scaffold

Arguments:
  project-name             project name

Options:
  -V, --version            output the version number
  --framework <framework>  vanilla | vue | react
  --variant <variant>      typescript | javascript
  --features <features>    comma-separated: lint,biome,vitest (lint and biome

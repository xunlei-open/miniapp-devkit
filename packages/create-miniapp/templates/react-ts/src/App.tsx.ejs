import { useState } from 'react'

export default function App() {
  const [count, setCount] = useState(0)

  return (
    <div className="app">
      <main className="app-main">
        <h1><%= projectName %></h1>
        <p>迅雷开放平台脚手架：Vanilla / Vue / React Vite 项目生成器</p>
        <p>计数: {count}</p>
        <button
          type="button"
          className="app-button"
          onClick={() => setCount((c) => c + 1)}
        >
          +1
        </button>
      </main>
    </div>
  )
}

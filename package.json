{
  "name": "@xunlei-open/miniapp-devkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --stream build",
    "check": "pnpm --recursive --stream --if-present check",
    "skill:sync": "node scripts/sync-skill-types.mjs",
    "clean": "pnpm --recursive --stream --if-present clean",
    "changeset": "pnpm --recursive --filter './packages/*' exec npm version --no-git-tag-version --ignore-scripts",
    "changeset:beta": "pnpm changeset prerelease --preid=beta",
    "test": "pnpm --recursive --stream --if-present test",
    "verify": "pnpm build && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
